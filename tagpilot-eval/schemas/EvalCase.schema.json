{
  "$defs": {
    "Expectation": {
      "additionalProperties": false,
      "properties": {
        "outcomes": {
          "items": {
            "enum": [
              "READY",
              "NEEDS_USER_INPUT",
              "CAPABILITY_GAP",
              "PARTIAL"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Outcomes",
          "type": "array"
        },
        "tree": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tree"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_slots": {
          "items": {
            "type": "string"
          },
          "title": "Required Slots",
          "type": "array"
        },
        "gap_codes": {
          "items": {
            "type": "string"
          },
          "title": "Gap Codes",
          "type": "array"
        },
        "gap_subjects": {
          "items": {
            "type": "string"
          },
          "title": "Gap Subjects",
          "type": "array"
        },
        "prohibited_behaviors": {
          "items": {
            "type": "string"
          },
          "title": "Prohibited Behaviors",
          "type": "array"
        }
      },
      "required": [
        "outcomes"
      ],
      "title": "Expectation",
      "type": "object"
    },
    "Expression": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "TAG",
            "CONST",
            "ADD",
            "SUB",
            "MUL",
            "DIV",
            "COUNT_POSITIVE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "tag_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag Id"
        },
        "field_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Name"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "default": "NONE",
          "title": "Unit",
          "type": "string"
        },
        "args": {
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "maxItems": 12,
          "title": "Args",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Expression",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "authoring": {
          "default": "DETERMINISTIC_FROM_AGENT_RECIPE",
          "enum": [
            "DETERMINISTIC_FROM_AGENT_RECIPE",
            "MODEL_EXPRESSION_FROM_DETERMINISTIC_TRUTH"
          ],
          "title": "Authoring",
          "type": "string"
        },
        "ai_review": {
          "const": "NOT_INDEPENDENTLY_REVIEWED",
          "default": "NOT_INDEPENDENTLY_REVIEWED",
          "title": "Ai Review",
          "type": "string"
        },
        "human_review": {
          "const": "PENDING",
          "default": "PENDING",
          "title": "Human Review",
          "type": "string"
        },
        "official_bank_signoff": {
          "const": false,
          "default": false,
          "title": "Official Bank Signoff",
          "type": "boolean"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Tree": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "GROUP",
            "PREDICATE",
            "SCOPE_ALL"
          ],
          "title": "Kind",
          "type": "string"
        },
        "logic": {
          "anyOf": [
            {
              "enum": [
                "AND",
                "OR"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logic"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Tree"
          },
          "maxItems": 30,
          "title": "Children",
          "type": "array"
        },
        "expression": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operator": {
          "anyOf": [
            {
              "enum": [
                "=",
                "!=",
                ">",
                ">=",
                "<",
                "<=",
                "in",
                "not_in",
                "between",
                "contains",
                "is_null",
                "is_not_null"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Values",
          "type": "array"
        },
        "data_kind": {
          "anyOf": [
            {
              "enum": [
                "NUMBER",
                "STRING",
                "DATE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Kind"
        },
        "null_policy": {
          "const": "EXCLUDE",
          "default": "EXCLUDE",
          "title": "Null Policy",
          "type": "string"
        },
        "caliber": {
          "additionalProperties": true,
          "title": "Caliber",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Tree",
      "type": "object"
    },
    "Turn": {
      "additionalProperties": false,
      "properties": {
        "user_message": {
          "minLength": 1,
          "title": "User Message",
          "type": "string"
        },
        "answer_slots": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Answer Slots",
          "type": "object"
        },
        "expected": {
          "$ref": "#/$defs/Expectation"
        }
      },
      "required": [
        "user_message",
        "expected"
      ],
      "title": "Turn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "eval-case.v1",
      "enum": [
        "eval-case.v1",
        "eval-case.v2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "pattern": "^CAL-\\d{3,4}$",
      "title": "Case Id",
      "type": "string"
    },
    "mother_id": {
      "pattern": "^M-\\d{3,4}$",
      "title": "Mother Id",
      "type": "string"
    },
    "lineage_group": {
      "title": "Lineage Group",
      "type": "string"
    },
    "phase": {
      "default": "P1",
      "enum": [
        "P1",
        "P2",
        "P3"
      ],
      "title": "Phase",
      "type": "string"
    },
    "split": {
      "default": "CALIBRATION",
      "enum": [
        "CALIBRATION",
        "UNPARTITIONED",
        "DEV",
        "REGRESSION",
        "HOLDOUT"
      ],
      "title": "Split",
      "type": "string"
    },
    "status": {
      "const": "DRAFT",
      "default": "DRAFT",
      "title": "Status",
      "type": "string"
    },
    "category": {
      "enum": [
        "SINGLE",
        "COMPOSITION",
        "CLARIFICATION",
        "BOUNDARY",
        "MULTITURN",
        "GAP"
      ],
      "title": "Category",
      "type": "string"
    },
    "persona": {
      "title": "Persona",
      "type": "string"
    },
    "scenario": {
      "title": "Scenario",
      "type": "string"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Domains",
      "type": "array"
    },
    "requirement": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Requirement",
      "type": "string"
    },
    "fact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Fact Ids",
      "type": "array"
    },
    "target_tag_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Target Tag Ids",
      "type": "array"
    },
    "forbidden_tag_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Forbidden Tag Ids",
      "type": "array"
    },
    "eligible_tag_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Eligible Tag Ids",
      "type": "array"
    },
    "reference_date": {
      "const": "2026-09-18",
      "default": "2026-09-18",
      "title": "Reference Date",
      "type": "string"
    },
    "timezone": {
      "const": "Asia/Shanghai",
      "default": "Asia/Shanghai",
      "title": "Timezone",
      "type": "string"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Sha256",
      "type": "string"
    },
    "expected": {
      "$ref": "#/$defs/Expectation"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/Turn"
      },
      "maxItems": 4,
      "title": "Turns",
      "type": "array"
    },
    "truth_basis": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Truth Basis",
      "type": "array"
    },
    "unresolved_fact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Fact Ids",
      "type": "array"
    },
    "l3_status": {
      "enum": [
        "FIXTURE_ORACLE_AVAILABLE",
        "NOT_APPLICABLE"
      ],
      "title": "L3 Status",
      "type": "string"
    },
    "variant_index": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Variant Index"
    },
    "variant_mode": {
      "anyOf": [
        {
          "enum": [
            "TEMPLATE",
            "MODEL_PARAPHRASE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Variant Mode"
    },
    "mother_requirement_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mother Requirement Sha256"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "case_id",
    "mother_id",
    "lineage_group",
    "category",
    "persona",
    "scenario",
    "domains",
    "requirement",
    "fact_ids",
    "target_tag_ids",
    "eligible_tag_ids",
    "source_manifest_sha256",
    "expected",
    "truth_basis",
    "l3_status"
  ],
  "title": "EvalCase",
  "type": "object"
}
