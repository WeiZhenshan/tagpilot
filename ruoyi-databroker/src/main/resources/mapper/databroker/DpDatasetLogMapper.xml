<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.databroker.mapper.DpDatasetLogMapper">

    <resultMap type="DpDatasetLog" id="LogResult">
        <id     property="logId"        column="log_id"        />
        <result property="datasetId"    column="dataset_id"    />
        <result property="versionId"    column="version_id"    />
        <result property="operType"     column="oper_type"     />
        <result property="operatorName" column="operator_name" />
        <result property="result"       column="result"        />
        <result property="message"      column="message"       />
        <result property="detailJson"   column="detail_json"   />
        <result property="operTime"     column="oper_time"     />
    </resultMap>

    <sql id="selectVo">
        select log_id, dataset_id, version_id, oper_type, operator_name, result, message, detail_json, oper_time
        from dp_dataset_log
    </sql>

    <select id="selectLogList" parameterType="DpDatasetLog" resultMap="LogResult">
        <include refid="selectVo"/>
        <where>
            <if test="datasetId != null">and dataset_id = #{datasetId}</if>
            <if test="versionId != null">and version_id = #{versionId}</if>
            <if test="operType != null and operType != ''">and oper_type = #{operType}</if>
            <if test="result != null and result != ''">and result = #{result}</if>
        </where>
        order by oper_time desc
    </select>

    <insert id="insertLog" parameterType="DpDatasetLog" useGeneratedKeys="true" keyProperty="logId">
        insert into dp_dataset_log (
            dataset_id, version_id, oper_type, operator_name, result, message, detail_json, oper_time
        ) values (
            #{datasetId}, #{versionId}, #{operType}, #{operatorName}, #{result}, #{message}, #{detailJson}, sysdate()
        )
    </insert>

</mapper>
