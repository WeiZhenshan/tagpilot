{
  "additionalProperties": false,
  "properties": {
    "metric": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Metric",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "category": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "tag_id": {
      "exclusiveMinimum": 0,
      "title": "Tag Id",
      "type": "integer"
    },
    "snapshot_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "unit": {
      "enum": [
        "人",
        "元",
        "%",
        "pp",
        "分"
      ],
      "title": "Unit",
      "type": "string"
    },
    "status": {
      "default": "DRAFT",
      "enum": [
        "DRAFT",
        "REVIEWED",
        "PUBLISHED",
        "RETIRED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "metric",
    "version",
    "tag_id",
    "snapshot_id",
    "unit"
  ],
  "title": "MetricBinding",
  "type": "object"
}
