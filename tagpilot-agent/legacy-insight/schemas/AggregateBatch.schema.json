{
  "$defs": {
    "AggregateRow": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Dimensions",
          "type": "array"
        },
        "n": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "holders": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holders"
        },
        "missing": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing"
        },
        "unheld": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unheld"
        },
        "suitable": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suitable"
        },
        "opportunity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opportunity"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "reasons": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 2,
          "title": "Reasons",
          "type": "array"
        },
        "channel": {
          "anyOf": [
            {
              "maxLength": 24,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "contributions": {
          "maxProperties": 8,
          "patternProperties": {
            "^[a-z][a-z0-9_.-]{0,79}$": {
              "type": "number"
            }
          },
          "title": "Contributions",
          "type": "object"
        },
        "status": {
          "default": "AVAILABLE",
          "enum": [
            "AVAILABLE",
            "SUPPRESSED",
            "MISSING"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "AggregateRow",
      "type": "object"
    },
    "QueryAggregate": {
      "additionalProperties": false,
      "properties": {
        "standardization_mode": {
          "default": "aum_risk",
          "enum": [
            "aum_risk",
            "aum",
            "risk"
          ],
          "title": "Standardization Mode",
          "type": "string"
        },
        "query_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Query Id",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/AggregateRow"
          },
          "maxItems": 144,
          "title": "Rows",
          "type": "array"
        },
        "status": {
          "default": "AVAILABLE",
          "enum": [
            "AVAILABLE",
            "SUPPRESSED",
            "MISSING"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 500,
          "title": "Reason",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "evidence_id"
      ],
      "title": "QueryAggregate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "skill_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Skill Id",
      "type": "string"
    },
    "pack_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Pack Hash",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "binding_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Binding Version",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "data_as_of": {
      "format": "date",
      "title": "Data As Of",
      "type": "string"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/QueryAggregate"
      },
      "maxItems": 40,
      "title": "Queries",
      "type": "array"
    },
    "benchmark_definition": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Benchmark Definition",
      "type": "string"
    },
    "benchmark_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Benchmark Version",
      "type": "string"
    },
    "scope_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scope Hash",
      "type": "string"
    }
  },
  "required": [
    "skill_id",
    "pack_hash",
    "snapshot_id",
    "binding_version",
    "plan_hash",
    "data_as_of",
    "queries",
    "benchmark_definition",
    "benchmark_version",
    "scope_hash"
  ],
  "title": "AggregateBatch",
  "type": "object"
}
